    def run_integrity_audit(self):
        """Auditoría estadística con división limpia por slots."""
        unique_slots = sorted(self.df['slot'].unique())
        if len(unique_slots) < 2:
            raise ValueError("Insuficientes slots para una auditoría comparativa válida.")

        mid_idx = len(unique_slots) // 2
        cut_slot = unique_slots[mid_idx]
        
        # División estricta sin solapamiento
        seg1 = self.df[self.df['slot'] < cut_slot]
        seg2 = self.df[self.df['slot'] >= cut_slot]
        
        shared_slots = set(seg1['slot'].unique()).intersection(set(seg2['slot'].unique()))
        if len(shared_slots) > 0:
            raise RuntimeError(f"CRITICAL: Solapamiento de slots detectado ({len(shared_slots)}). Abortando.")

        # Cálculo de Correlación (Pearson) entre llegada y duración
        r1, p1 = stats.pearsonr(seg1['recv_ns'], seg1['window_duration_ns'])
        r2, p2 = stats.pearsonr(seg2['recv_ns'], seg2['window_duration_ns'])
        
        metrics = {
            "seg1_rho": float(r1), "seg1_p": float(p1), "seg1_events": len(seg1),
            "seg2_rho": float(r2), "seg2_p": float(p2), "seg2_events": len(seg2),
            "diff_abs": float(abs(r1 - r2)),
            "cut_slot_id": int(cut_slot)
        }
        
        logger.info(f"Auditoría completada. Diferencia de Rhos: {metrics['diff_abs']:.4f}")
        return metrics

    def create_audit_bundle(self, metrics):
        """Genera un bundle inmutable con los resultados y firma digital."""
        protocol_meta = {
            "engine_version": "5.1-production",
            "target_event": "Solana 250ms Slot Upgrade (Sept 18, 2026)",
            "timestamp_utc": time.time(),
            "source_file_hash": self._get_file_hash()[:32]
        }
        
        payload = {"metrics": metrics, "protocol": protocol_meta}
        payload_str = json.dumps(payload, sort_keys=True).encode('utf-8')
        content_hash = hashlib.sha3_512(payload_str).hexdigest()
        
        signature = f"SIG_{self.signer_id}_{content_hash[:16]}"
        
        audit_bundle = {
            "content_hash": content_hash,
            "signature": signature,
            "payload": payload
        }
        
        print("\n[✅ BUNDLE DE AUDITORÍA GENERADO]")
        print(f"  Hash de Integridad: {content_hash[:20]}...")
        print(f"  Firma: {signature}")
        print(f"  Estabilidad de Señal (Diff Rho): {metrics['diff_abs']:.4f}")
        print("  -> Este bundle es verificable por terceros sin acceso a los datos crudos.")
        
        return audit_bundle
